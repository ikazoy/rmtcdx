{
  "name": "remote-control-codex-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c blue,magenta \"npm run dev -w remote-control-codex\" \"npm run dev -w @codex-remote/web\"",
    "build": "npm run build -w remote-control-codex",
    "start": "npm run start -w remote-control-codex"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
