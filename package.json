{
  "name": "remodex-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c blue,magenta \"PORT=3000 npm run dev -w remodex\" \"npm run dev -w @codex-remote/web\"",
    "build": "npm run build -w remodex",
    "compat:canary": "npm run compat:canary -w remodex",
    "compat:fixtures": "npm run compat:fixtures -w remodex",
    "start": "npm run start -w remodex",
    "test": "npm run test -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
