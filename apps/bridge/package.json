{
  "name": "remote-control-codex",
  "version": "0.1.0",
  "description": "Remote web client for operating OpenAI Codex CLI from your browser",
  "type": "module",
  "homepage": "https://github.com/ikazoy/remote-control-codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikazoy/remote-control-codex.git"
  },
  "keywords": [
    "codex",
    "openai",
    "fastify",
    "remote-control",
    "websocket"
  ],
  "bin": {
    "remote-control-codex": "./dist/main.js"
  },
  "files": [
    "dist",
    "web-dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm --prefix ../.. run build -w @codex-remote/web && tsc -p tsconfig.json --noEmit && tsup src/main.ts --format esm --out-dir dist --clean && node ./scripts/copy-web-dist.mjs",
    "start": "node dist/main.js",
    "test": "tsx --test test/codex-compat/*.test.ts",
    "prepack": "npm --prefix ../.. run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "pino": "^9.11.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@codex-remote/shared-types": "file:../../packages/shared-types",
    "@types/node": "^24.6.0",
    "@types/web-push": "^3.6.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
